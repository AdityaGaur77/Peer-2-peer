# Supabase connection (Settings → API). Leave these out to run offline with everything in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The founder console passcode (/#/admin). Required for the deployed console.
VITE_ADMIN_CODE=

# Optional: protect sign-in from email-sending abuse. See SUPABASE.md (hCaptcha).
# VITE_HCAPTCHA_SITE_KEY=
